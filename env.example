# Example environment variables for this project
# Copy this file to `.env` and fill the values for local development.

# Public URL used by the app (change after you have your Vercel URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database connection URL (SQLite/LibSQL, e.g. Turso).
# Examples:
#   Local SQLite: file:./local.db
#   LibSQL/Turso: libsql://<your-url>
DATABASE_URL=

# Optional DB provider auth token (if your DB provider uses a token)
DATABASE_AUTH_TOKEN=

# Resend (or other email service) API key used for sending emails
RESEND_API_KEY=

# Default "from" address for invoice emails
# Example: DispoInvoice <invoice@yourdomain.com>
INVOICE_EMAIL_FROM=

# ── SANG PRABU AI (asisten publik) ────────────────────────────────────────
# Kunci API Anthropic — WAJIB server-side. JANGAN memakai NEXT_PUBLIC_*.
ANTHROPIC_API_KEY=
# Model Claude (opsional). Default: claude-opus-5.
# Untuk asisten publik bervolume tinggi, pertimbangkan claude-haiku-4-5 (lebih hemat).
AI_MODEL=
# Feature flag widget AI. "true" untuk menampilkan; selain itu (atau kosong) = mati.
NEXT_PUBLIC_AI_ENABLED=
